# =============================================================================
# wacrm — docker compose environment
# =============================================================================
#
# Copy this file to .env and fill in the generated secrets:
#
#   cp .env.example .env
#   npm run keys >> .env
#
# The last definition of each key wins, so the generated values (appended
# by `npm run keys`) override the placeholder markers below.
# .env.local.example is the separate file for `npm run dev` without Docker.

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=<generar con: npm run keys>
POSTGRES_DB=postgres
POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=<generar con: npm run keys>
ANON_KEY=<generar con: npm run keys>
SERVICE_ROLE_KEY=<generar con: npm run keys>
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# URLs and host ports
# -----------------------------------------------------------------------------
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
KONG_HTTP_PORT=8000
HOST_PORT=3000

# -----------------------------------------------------------------------------
# Auth (gotrue)
# -----------------------------------------------------------------------------
# Registro cerrado (BASE.3): Auth rechaza el autorregistro. El alta de
# invitados pasa por POST /api/invitations/<token>/signup (service role,
# exige invitación pendiente). El primer usuario lo crea el operador con la
# API admin de Auth. No lo cambies a false.
GOTRUE_DISABLE_SIGNUP=true
# Auto-confirm email addresses on a clean machine without an SMTP server.
# Remove this (or set to false) once you configure SMTP.
GOTRUE_MAILER_AUTOCONFIRM=true
# GOTRUE_SMTP_HOST=
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=
# GOTRUE_SMTP_PASS=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# -----------------------------------------------------------------------------
# The wacrm fork (Next.js)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL is the browser-facing URL of kong (localhost in
# phase 1, https://api.<DOMAIN> behind the tunnel). Server-side calls inside the
# `app` container use SUPABASE_INTERNAL_URL (set by docker-compose.yml).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<igual que ANON_KEY — generar con: npm run keys>
SUPABASE_SERVICE_ROLE_KEY=<igual que SERVICE_ROLE_KEY — generar con: npm run keys>
ENCRYPTION_KEY=<generar con: npm run keys>
REALTIME_ENC_KEY=<generar con: npm run keys>
META_APP_SECRET=<tu Meta App Secret>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=es

# -----------------------------------------------------------------------------
# Cron (scheduled tasks of wacrm)
# -----------------------------------------------------------------------------
# Required: without it /api/automations/cron and /api/flows/cron answer 503.
AUTOMATION_CRON_SECRET=<generar con: npm run keys>
# Cron expression for both tasks (default: every 5 minutes).
CRON_SCHEDULE=*/5 * * * *

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (BASE.2) — outbound-only, no host ports
# -----------------------------------------------------------------------------
# Zero Trust > Networks > Tunnels > Create a tunnel (Cloudflared). Public
# hostnames: crm.<DOMAIN> -> http://app:3000, api.<DOMAIN> -> http://supabase-kong:8000.
# Only needed with `docker compose --profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Empresa (CFG.1) — un repo hijo por empresa, una base por empresa
# -----------------------------------------------------------------------------
# `node scripts/empresa/nueva-empresa.mjs` escribe COMPOSE_PROJECT_NAME=wacrm-<id>
# en el .env del hijo: volúmenes, red y contenedores propios por empresa.
COMPOSE_PROJECT_NAME=wacrm
# Destino de los backups diarios y aviso de fallo (los usa BAK.1).
BACKUP_DESTINO_URI=<s3://bucket/ruta — lo usa BAK.1>
BACKUP_DESTINO_CREDENCIAL=<credencial del destino — lo usa BAK.1>
BACKUP_AVISO_WEBHOOK=<https://… — lo usa BAK.1>
