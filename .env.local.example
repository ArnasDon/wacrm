# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required WHEN YOU USE THE OFFICIAL META CLOUD API — without it the
# webhook rejects every request. If every channel of yours runs through
# Evolution (the QR-code transport, below), leave it unset: the Meta
# webhook simply never receives anything.
#
# Several official numbers (WABAs) under ONE Meta App need only that
# app's secret. If your WABAs live under DIFFERENT Meta Apps (each app
# signs with its own secret), list every app's secret separated by
# commas; a webhook is accepted when its signature matches any of them —
# so every app in the list must be one YOU trust: any of their secrets
# can sign a delivery for any number of this installation.
# Write the list WITHOUT spaces. The server env file is loaded by the
# shell (`set -a; . crm.env`), and `a, b` there makes the whole variable
# vanish — every Meta webhook then fails with 401. See docs/multi-waba.md.
#   META_APP_SECRET=secret-of-app-one,secret-of-app-two
META_APP_SECRET=your-meta-app-secret

# Shared secret protecting the scheduler routes (x-cron-secret header):
# /api/automations/cron, /api/flows/cron and /api/cb/{scheduled,radar,
# meta-ads,tldv,asaas}/cron. REQUIRED in production: without it every one
# of them answers 503, and scheduled messages, "Wait" steps, date
# reminders, the Radar and the Meta Ads / tl;dv / Asaas syncs all stop —
# with nothing on screen saying so. The same value goes to the scheduler
# service (docs/INSTALACAO.md, step 5.4). Generate any long random string:
#   openssl rand -hex 32
AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ============================================================
# WHATSAPP VIA EVOLUTION API
#
# Two ways to connect WhatsApp are supported, and each install picks
# per channel:
#
#   * Meta Cloud API — the official one. Needs a Business account, an
#     approved phone number and message templates. Configured in the UI,
#     plus META_APP_SECRET above.
#   * Evolution API — an open-source gateway you host yourself and pair
#     by QR code, like WhatsApp Web. No Meta approval, no templates, and
#     no 24-hour window. This is what the three variables below drive.
#
# Skip this whole block if you only use the Meta Cloud API. If you use
# Evolution, ALL THREE are required: without them the app cannot create
# an instance, cannot pair a number, and rejects every inbound webhook.
# ============================================================

# Where your Evolution server listens, scheme included, no trailing
# slash. Plain http is accepted on purpose: Evolution is meant to be
# reached over a private network, so the API key and the message bodies
# never leave it. Only the CRM's own public address needs TLS.
#
# ⚠️ In the documented deploy (Docker Swarm), use the Evolution service's
# name on the shared overlay network — `<stack>_<service>`, e.g.
# http://evolution_evolution:8080 — NEVER 127.0.0.1: inside the CRM
# container, 127.0.0.1 is the container itself, and the result is a
# "connection refused" with no connection and no pairing
# (docs/INSTALACAO.md, step 3.1). 127.0.0.1 only works in local
# development, with the CRM and Evolution running directly on your
# machine.
# EVOLUTION_BASE_URL=http://evolution_evolution:8080

# Evolution's global API key (AUTHENTICATION_API_KEY in its own env).
# The CRM uses it to create and pair instances. It is the master key of
# that server — treat it like a root password.
# EVOLUTION_GLOBAL_API_KEY=your-evolution-global-key

# Shared secret the CRM writes into each instance's webhook headers and
# then checks on every delivery (Authorization: Bearer <secret>). It is
# what stops anyone who learns your webhook URL from injecting messages
# into the inbox. Generate any long random string:
#   openssl rand -hex 32
# ⚠️ Changing it does not update instances that are already paired —
# re-save the connection ("Ressincronizar") so the new value reaches
# Evolution, or inbound messages start being rejected.
# EVOLUTION_WEBHOOK_SECRET=generate-a-long-random-string

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). REQUIRED in production. The server builds from it every URL
# that someone else calls back or that leaves the CRM: the Evolution,
# Calendly, tl;dv and Asaas webhooks, the Instagram OAuth redirect, the
# incoming-webhook URLs, invite links and the links automations send to
# clients ({{contact.link}}). Without it the Asaas webhook is never
# created (the cron has no request to take an address from), automation
# links go out relative, and the rest fall back to the request's origin.
#
# ⚠️ Like every NEXT_PUBLIC_* variable, it is inlined AT BUILD TIME (a
# build-arg — docs/INSTALACAO.md, step 5.1): changing it on a running
# server does nothing. And after changing the domain, the addresses
# registered with third parties have to be registered again (Evolution:
# "Ressincronizar"; Calendly: "Reassinar"; Asaas: re-link the webhook;
# Instagram, tl;dv and Typebot/n8n: by hand in each of them).
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Interface language. Two dictionaries ship complete and in parity:
# `en` and `pt-BR` (messages/*.json). Any other value falls back to
# English.
#
# ⚠️ Every NEXT_PUBLIC_* variable is inlined into the client bundle AT
# BUILD TIME. Changing this on a running server does nothing — the image
# has to be rebuilt. Same goes for the three below.
NEXT_PUBLIC_APP_LOCALE=en

# Product name, as it shows in the browser tab and the sidebar. Leave it
# unset and the app calls itself "CRM".
# NEXT_PUBLIC_APP_NAME=Acme CRM

# Optional logo for the sidebar, replacing the default glyph. Drop the
# file under `public/` and point at it with an absolute path. Unset
# keeps the default mark.
# NEXT_PUBLIC_APP_LOGO_URL=/marca/logo.svg

# Short name shown under the icon when someone installs the app on a
# phone's home screen — the iPhone cuts long names there. Unset uses
# NEXT_PUBLIC_APP_NAME.
# NEXT_PUBLIC_APP_SHORT_NAME=Acme

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, a hostname that is not on the list is
# rejected and the request FAILS with a 500 that names this
# variable — no invitation row is created, so nothing is left
# behind for an admin to revoke. When unset, behavior is unchanged
# from earlier versions: the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Local development only (read by next.config.ts): extra origins allowed
# to load the dev server — a tunnel domain, for instance. Comma-separated.
# No effect on a production build.
# ALLOWED_DEV_ORIGINS=my-tunnel.example.com

# Local Docker Compose only (docker-compose.yml): the host port the app is
# published on. Use HOST_PORT, not PORT (docs/docker.md).
# HOST_PORT=8080

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
#
# Single value only — unlike META_APP_SECRET it does not take a list.
# With WABAs under several Meta Apps, image-header template uploads go
# through this one app for every account (docs/multi-waba.md, "O que NÃO funciona com apps diferentes").
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI, Anthropic or Google (Gemini) key under Settings → Integrations. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → Integrations (it has to be an OpenAI key). Still no env var
# required. Audio transcription works only with a Gemini key.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Instagram Direct (optional)
# ------------------------------------------------------------------
# Nothing to set here. Under Settings → Connections → "Instagram Direct",
# each account registers its own Meta app once (Instagram App ID and
# Instagram App Secret, stored AES-256-GCM-encrypted with ENCRYPTION_KEY)
# and connects each Instagram account by logging in to Instagram (OAuth).
# Register the OAuth Redirect URI shown on screen in the Meta App
# Dashboard, or the login ends on an Instagram error page. Pasting an
# access token by hand is still accepted as an alternative. The webhook
# verify token is generated by the CRM per connection and shown on screen
# for you to paste into the Meta App Dashboard. Tokens last 60 days.
#
# META_APP_SECRET (above) is for the WhatsApp Cloud API only — it does NOT
# sign Instagram webhooks (measured: those are signed with the Instagram
# App Secret from the Instagram product tab, which lives per connection).
