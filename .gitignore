# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Supabase CLI local state
/supabase/.temp/

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos sensibles de clientes (onboarding con info bancaria/personal) — nunca commitear
docs/clientes/.local/

# AI eval suite (npm run eval:ai) — the built prompt + promptfoo's own
# cache/output can carry real business content and are regenerated on
# every run; never the decrypted API key, which never touches disk.
# promptfoo lives in evals/ai/'s OWN package.json/node_modules —
# deliberately isolated from the root one, see evals/ai/run.ts's own
# comment for why — so its node_modules needs its own ignore line too
# (the root /node_modules rule above is anchored, doesn't reach here).
evals/ai/*.local.txt
evals/ai/*.local.json
evals/ai/node_modules/
.promptfoo/
