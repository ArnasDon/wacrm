# ============================================================
# Combined wacrm + listmonk deployment.
# Copy to `.env` in this directory and fill in.
# ============================================================

# Your domain. DNS A record must already point at this server —
# Caddy provisions the TLS certificate on first boot.
# One hostname. The email engine is not exposed publicly; only the
# CRM is, and recipient-facing unsubscribe/tracking links are proxied
# under this same domain.
DOMAIN=crm.example.com
TZ=Etc/UTC

# ------------------------------------------------------------
# Supabase — the CRM database, auth, storage and realtime.
# Create a project at supabase.com, then apply the migrations:
#   supabase link --project-ref <ref> && supabase db push
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# wacrm secrets
# ------------------------------------------------------------
# 64 hex chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every stored WhatsApp token.
ENCRYPTION_KEY=

# Meta for Developers → App Settings → Basic. Without it the
# WhatsApp webhook rejects every inbound message.
META_APP_SECRET=

NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en

# Protects the automation/flow cron drain endpoints.
#   openssl rand -hex 32
AUTOMATION_CRON_SECRET=

# ------------------------------------------------------------
# listmonk (email engine)
# ------------------------------------------------------------
#   openssl rand -hex 24
LISTMONK_DB_PASSWORD=
# A superadmin still has to exist inside the engine (it refuses to
# run without one), but nothing reaches its login page from outside.
# Configure email under Email -> Settings in the CRM instead.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# The API user wacrm authenticates as. Created AFTER first boot —
# see step 4 in README.md. listmonk caches API users at startup, so
# the container must be restarted once after you create it.
LISTMONK_API_USER=wacrm_api
LISTMONK_API_TOKEN=
