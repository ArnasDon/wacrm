---
// LeadForm — formulario de la landing (DAD §3.2).
//
// Flujo: god.js rellena los hidden fields (utm_*, click-ids, ref_code,
// event_id, channel, medium, visitor_id) ANTES del submit. El form hace
// POST JSON a /api/events con event_type=form_submit → el server crea el
// lead (find-or-create por teléfono, reusando el ingest de /api/v1/contacts
// sin exponer la API key) + inserta el tracking_event con la atribución.
//
// Al éxito → redirect a /thank-you?lead=1&event_id=... (el thank-you
// re-emite form_submit con el MISMO event_id: idempotente por UNIQUE).
//
// Validación Zod en cliente (misma regla que el server: phone requerido).
import { site } from "../data/site";

const { landingBase } = site;
---

<form
  id="lead-form"
  data-no-track
  class="mx-auto grid max-w-md gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
  novalidate
>
  <h3 class="text-lg font-semibold text-slate-900">Agenda tu valoración</h3>
  <p class="text-sm text-slate-600">Te contactamos por WhatsApp en menos de 24 h.</p>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Nombre</span>
    <input
      name="name"
      type="text"
      required
      placeholder="Tu nombre"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Teléfono *</span>
    <input
      name="phone"
      type="tel"
      required
      placeholder="+52 55 1234 5678"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Email</span>
    <input
      name="email"
      type="email"
      placeholder="tu@email.com"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Mensaje</span>
    <textarea
      name="message"
      rows="3"
      placeholder="¿Qué te gustaría consultar?"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    ></textarea>
  </label>

  <!-- hidden fields rellenados por god.js (DAD §2.2 fillHiddenInputs) -->
  <input type="hidden" name="utm_source" />
  <input type="hidden" name="utm_medium" />
  <input type="hidden" name="utm_campaign" />
  <input type="hidden" name="utm_term" />
  <input type="hidden" name="utm_content" />
  <input type="hidden" name="gclid" />
  <input type="hidden" name="gbraid" />
  <input type="hidden" name="wbraid" />
  <input type="hidden" name="fbclid" />
  <input type="hidden" name="msclkid" />
  <input type="hidden" name="ttclid" />
  <input type="hidden" name="li_fat_id" />
  <input type="hidden" name="gad_source" />
  <input type="hidden" name="landing_slug" />
  <input type="hidden" name="ref_code" />
  <input type="hidden" name="event_id" />
  <input type="hidden" name="channel" />
  <input type="hidden" name="medium" />
  <input type="hidden" name="visitor_id" />

  <button
    type="submit"
    class="w-full rounded-full bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-700"
  >
    Solicitar información
  </button>
  <p id="lead-form-error" class="hidden text-sm text-red-600"></p>
</form>

<script>
  const FORM_ID = "lead-form";
  const ERR_ID = "lead-form-error";

  function readHidden(form: HTMLFormElement, name: string): string {
    return form.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.value ?? "";
  }

  function showError(msg: string): void {
    const el = document.getElementById(ERR_ID);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove("hidden");
  }

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById(FORM_ID) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const err = document.getElementById(ERR_ID);
      err?.classList.add("hidden");

      const name = readHidden(form, "name");
      const phone = readHidden(form, "phone").trim();
      const email = readHidden(form, "email");
      const message = readHidden(form, "message");

      if (!phone) {
        showError("Por favor ingresa tu teléfono.");
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (button) {
        button.disabled = true;
        button.textContent = "Enviando...";
      }

      const event_id = readHidden(form, "event_id");
      const attribution = {
        utm: {
          source: readHidden(form, "utm_source") || undefined,
          medium: readHidden(form, "utm_medium") || undefined,
          campaign: readHidden(form, "utm_campaign") || undefined,
          term: readHidden(form, "utm_term") || undefined,
          content: readHidden(form, "utm_content") || undefined,
        },
        click_ids: {
          gclid: readHidden(form, "gclid") || undefined,
          gbraid: readHidden(form, "gbraid") || undefined,
          wbraid: readHidden(form, "wbraid") || undefined,
          fbclid: readHidden(form, "fbclid") || undefined,
          msclkid: readHidden(form, "msclkid") || undefined,
          ttclid: readHidden(form, "ttclid") || undefined,
          li_fat_id: readHidden(form, "li_fat_id") || undefined,
          gad_source: readHidden(form, "gad_source") || undefined,
        },
        landing_slug: readHidden(form, "landing_slug") || undefined,
        ref_code: readHidden(form, "ref_code") || undefined,
        channel: readHidden(form, "channel") || undefined,
        medium: readHidden(form, "medium") || undefined,
        visitor_id: readHidden(form, "visitor_id") || undefined,
      };

      try {
        const res = await fetch(`${location.origin}/api/events`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            event_id: event_id || `form_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`,
            event_type: "form_submit",
            attribution,
            ref_code: attribution.ref_code,
            landing_slug: attribution.landing_slug,
            payload: { name, phone, email, message },
          }),
        });
        if (!res.ok) throw new Error("request failed");
        const qs = new URLSearchParams({ lead: "1", event_id: event_id || "" });
        window.location.href = `${location.origin}${landingBase}/thank-you?${qs}`;
      } catch {
        showError("Hubo un problema. Intenta de nuevo o escríbenos por WhatsApp.");
        if (button) {
          button.disabled = false;
          button.textContent = "Solicitar información";
        }
      }
    });
  });
</script>
