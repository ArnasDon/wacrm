---
// LeadForm — formulario de la landing (DAD §3.2).
//
// Flujo: god.js rellena los hidden fields (utm_*, click-ids, ref_code,
// event_id, channel, medium, visitor_id) ANTES del submit. El form hace
// POST JSON a /api/events con event_type=form_submit → el server crea el
// lead (find-or-create por teléfono, reusando el ingest de /api/v1/contacts
// sin exponer la API key) + inserta el tracking_event con la atribución.
//
// Al éxito → redirect a /thank-you?lead=1&event_id=... (el thank-you
// re-emite form_submit con el MISMO event_id: idempotente por UNIQUE).
//
// Validación Zod en cliente (misma regla que el server: phone requerido).
import { site } from "../data/site";

const { landingBase } = site;
---

<form
  id="lead-form"
  data-landing-base={landingBase}
  class="mx-auto grid max-w-md gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
  novalidate
>
  <h3 class="text-lg font-semibold text-slate-900">Agenda tu valoración</h3>
  <p class="text-sm text-slate-600">Te contactamos por WhatsApp en menos de 24 h.</p>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Nombre</span>
    <input
      name="name"
      type="text"
      required
      placeholder="Tu nombre"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Teléfono *</span>
    <input
      name="phone"
      type="tel"
      required
      placeholder="+52 55 1234 5678"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Email</span>
    <input
      name="email"
      type="email"
      placeholder="tu@email.com"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-slate-700">Mensaje</span>
    <textarea
      name="message"
      rows="3"
      placeholder="¿Qué te gustaría consultar?"
      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none"
    ></textarea>
  </label>

  <!-- hidden fields rellenados por god.js (DAD §2.2 fillHiddenInputs) -->
  <input type="hidden" name="utm_source" />
  <input type="hidden" name="utm_medium" />
  <input type="hidden" name="utm_campaign" />
  <input type="hidden" name="utm_term" />
  <input type="hidden" name="utm_content" />
  <input type="hidden" name="gclid" />
  <input type="hidden" name="gbraid" />
  <input type="hidden" name="wbraid" />
  <input type="hidden" name="fbclid" />
  <input type="hidden" name="msclkid" />
  <input type="hidden" name="ttclid" />
  <input type="hidden" name="li_fat_id" />
  <input type="hidden" name="gad_source" />
  <input type="hidden" name="landing_slug" />
  <input type="hidden" name="ref_code" />
  <input type="hidden" name="event_id" />
  <input type="hidden" name="channel" />
  <input type="hidden" name="medium" />
  <input type="hidden" name="visitor_id" />

  <button
    type="submit"
    class="w-full rounded-full bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-700"
  >
    Solicitar información
  </button>
  <p id="lead-form-error" class="hidden text-sm text-red-600"></p>
</form>

<script>
  // Módulo aparte para que Astro lo compile y lo empaquete: un
  // <script define:vars> es is:inline y llegaría al navegador con los
  // tipos de TypeScript puestos. Ver landing/src/scripts/lead-form.ts.
  import "../scripts/lead-form";
</script>
