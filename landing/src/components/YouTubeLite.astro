---
// YouTubeLite — fachada de vídeo bajo demanda (skill §12.1) con proporción
// mobile-first.
//
// LA REGLA: en móvil el vídeo es VERTICAL 9:16 siempre. El horizontal es la
// excepción. Un vertical al lado de un formulario o dentro de una tarjeta
// ocupa mejor la columna que un 16:9 aplastado; la única sección que exige
// horizontal a pantalla completa en escritorio es la VSL.
//
// Dos ids de YouTube, no uno:
//   id         → el vídeo VERTICAL (móvil). Obligatorio.
//   desktopId  → el HORIZONTAL. Si falta, se reutiliza el vertical.
//
// El iframe no existe hasta el clic: ~1 KB en lugar de los ~540 KB del
// reproductor, y 0 conexiones a Google antes de que el usuario decida.
import { site } from '../data/site';

interface Props {
  /** Id del vídeo vertical (móvil). */
  id?: string;
  /** Id del horizontal para escritorio. Opcional. */
  desktopId?: string;
  /**
   * 'auto'       vertical en móvil, horizontal en escritorio (por defecto)
   * 'vertical'   vertical siempre — junto a un formulario, o en tarjeta
   * 'horizontal' horizontal siempre — VSL
   */
  ratio?: 'auto' | 'vertical' | 'horizontal';
  playlabel?: string;
  /** Miniaturas propias. Si faltan, se usan las de YouTube. */
  thumbMobile?: string;
  thumbDesktop?: string;
}

const {
  id = site.videoId,
  desktopId,
  ratio = 'auto',
  playlabel = 'Ver vídeo',
  thumbMobile,
  thumbDesktop,
} = Astro.props;

const ytThumb = (v: string) => `https://i.ytimg.com/vi/${v}/hqdefault.jpg`;
const mobileThumb = thumbMobile ?? ytThumb(id);
const desktopThumb = thumbDesktop ?? ytThumb(desktopId ?? id);
---

<div
  class:list={[
    'youtube-video',
    ratio === 'vertical' && 'ratio-vertical',
    ratio === 'horizontal' && 'ratio-horizontal',
  ]}
  data-video-id={id}
  data-desktop-video-id={desktopId}
>
  {/* Mobile-first también en el marcado: el <img> lleva la miniatura vertical
      y el <source> la horizontal, que solo entra a partir de 900px. */}
  <picture>
    {desktopThumb !== mobileThumb && (
      <source media="(min-width: 900px)" srcset={desktopThumb} width="960" height="540" />
    )}
    <img src={mobileThumb} width="1080" height="1920" alt={playlabel} loading="lazy" decoding="async" />
  </picture>
  {/* El disparador es el botón, no el bloque entero: god.js exige clic en
      `.play-button`. `type=button` + aria-label lo hacen operable con teclado,
      que es lo único que le añado a tu versión. */}
  <button type="button" class="play-button" aria-label={playlabel}
          data-track="video_play" data-track-label={id}>
    <svg viewBox="0 0 24 24" width="68" height="48">
      <path
        fill="#f00"
        d="M23.5 6.2c-.3-1.1-1.2-2-2.3-2.3C19.3 3.5 12 3.5 12 3.5s-7.3 0-9.2.4c-1.1.3-2 1.2-2.3 2.3C.1 8.1.1 12 .1 12s0 3.9.4 5.8c.3 1.1 1.2 2 2.3 2.3 1.9.4 9.2.4 9.2.4s7.3 0 9.2-.4c1.1-.3 2-1.2 2.3-2.3.4-1.9.4-5.8.4-5.8s0-3.9-.4-5.8z"
      ></path>
      <path fill="#fff" d="M9.8 15.5v-7l6.5 3.5-6.5 3.5z"></path>
    </svg>
  </button>
  <div class="youtube-iframe"></div>
</div>

{/* Sin script propio: el diferido del vídeo vive en god.js
    (wireYouTubeFacades), que ya se carga en todas las páginas. */}

<style>
  .play-button {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.3);
    transition: background 0.2s ease;
    z-index: 2;
  }
  .youtube-video:hover .play-button {
    background: rgb(0 0 0 / 0.5);
  }
  .play-button svg {
    filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.5));
    transition: transform 0.2s ease;
  }
  .youtube-video:hover .play-button svg {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .play-button,
    .play-button svg {
      transition: none;
    }
  }
</style>
