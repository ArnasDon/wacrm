---
// Hero — contexto y promesa (skill §15.1, paso 1).
// El H1 confirma que el visitante llegó al sitio correcto; el subtítulo lleva
// la oferta concreta; dos botones: acción principal y canal alternativo.
import { site, whatsappHref, PRIMARY_CTA } from "../../data/site";
---

<section class="section" itemscope itemtype="https://schema.org/WPHeader">
  <div class="container">
    <div class="row is-vertical-align">
      <div class="col-7-md">
        <p class="badge mb-1">
          <span class="badge__dot" aria-hidden="true"></span>
          Agenda disponible esta semana
        </p>

        <h1 class="t-4xl lh-tight" itemprop="headline">
          Fisioterapia que te devuelve el movimiento
        </h1>

        <p class="lead measure-sm mb-2">
          Valoración inicial desde ${site.services[0].price} MXN, con diagnóstico y plan
          de tratamiento el mismo día. Te contactamos por WhatsApp en menos de 24 h.
        </p>

        <div class="btn-row">
          <a href="#agenda" class="button primary pill" data-track="cta_click" data-track-label="hero">
            {PRIMARY_CTA}
          </a>
          <a
            href={whatsappHref}
            class="button outline pill"
            target="_blank"
            rel="noopener"
            data-wa-cta
            data-track="whatsapp_click"
            data-track-label="hero"
          >
            Escribir por WhatsApp
          </a>
        </div>

        <ul class="inline-stats mt-2 list-unstyled">
          {site.proof.slice(0, 2).map((p) => (
            <li class="inline-stat">
              <strong class="inline-stat__num text-primary">{p.num}</strong>
              <span class="inline-stat__label">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="col-5-md">
        <div class="card card--lg">
          <p class="label text-grey">Primera valoración</p>
          <p class="t-3xl text-primary lh-1 mb-1">${site.services[0].price} MXN</p>
          <ul class="step-list">
            <li><span class="step-num">1</span> 45–60 minutos con un fisioterapeuta</li>
            <li><span class="step-num">2</span> Diagnóstico y plan por escrito</li>
            <li><span class="step-num">3</span> Sin compromiso de continuar</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Alineación a la izquierda solo en este bloque: .btn-row centra por
     defecto, y aquí el CTA acompaña al texto. */
  .btn-row { justify-content: flex-start; }
</style>
