---
// Bloque de captación. Aparece dos veces en el arquetipo transaccional
// (skill §16): una arriba, tras la prueba visual, y otra en el cierre.
// Los dos usan el MISMO componente de formulario con `formId` distinto, para
// que los id de cada campo sigan siendo únicos en el documento.
import ContactForm from "../ContactForm.astro";
import { PRIMARY_CTA } from "../../data/site";

interface Props {
  id: string;
  formId: string;
  heading: string;
  sub: string;
  dark?: boolean;
}

const { id, formId, heading, sub, dark = false } = Astro.props;
---

<section id={id} class:list={["section", dark ? "bg-dark" : "bg-secondary"]}>
  <div class="container">
    <div class="row is-vertical-align">
      <div class="col-6-md">
        <h2 class="t-3xl">{heading}</h2>
        <p class:list={["lead", "measure-sm", dark && "text-white"]}>{sub}</p>
      </div>
      <div class="col-6-md">
        <div class="card card--lg">
          <ContactForm formId={formId} cta={PRIMARY_CTA} />
        </div>
      </div>
    </div>
  </div>
</section>
