---
// Especialidades y precio (skill §15.1, pasos 4 y 5).
//
// El precio va visible a propósito: ocultarlo no elimina la objeción, la
// pospone hasta la llamada y desperdicia presupuesto de medios en leads no
// calificados. Un precio visible filtra tráfico y mejora la calidad del lead.
import { site } from "../../data/site";

interface Props {
  heading?: string;
  sub?: string;
  /** Servicios con precio. Default: site.services */
  services?: { name: string; desc: string; price: string }[];
}

const {
  heading = 'Tratamientos y precios',
  sub = 'Cada sesión incluye valoración de seguimiento y ajustes del plan según tu avance.',
  services = site.services,
} = Astro.props;
---

<section id="servicios" class="section" itemscope itemtype="https://schema.org/ItemList">
  <div class="container">
    <header class="section-header">
      <h2 class="t-3xl">{heading}</h2>
      <p class="lead measure-sm mx-auto">
        {sub}
      </p>
    </header>

    <div class="row">
      {services.map((s, i) => (
        <article
          class="col-6-md card h-100 flex-col"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/Service"
        >
          <meta itemprop="position" content={String(i + 1)} />
          <h3 class="t-xl is-marginless" itemprop="name">{s.name}</h3>
          <p class="text-body mt-1" itemprop="description">{s.desc}</p>
          <p
            class="card__foot t-2xl text-primary"
            itemprop="offers"
            itemscope
            itemtype="https://schema.org/Offer"
          >
            <meta itemprop="priceCurrency" content={site.currency} />
            <span itemprop="price" content={s.price}>${s.price}</span>
            <span class="t-sm text-grey fw-400"> {site.currency} / sesión</span>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
