---
// BaseLayout — shell HTML de la landing (DAD §3.1).
// Carga god.js (script de atribución, bundled a /god.js en la raíz de
// Next) + initAttribution() + wireClickBeacons(). El script se sirve
// desde /god.js (raíz de Next, NO desde /landing/) — DAD §3.1.
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Carga el script de Core Web Vitals (DAD §3.4) */
  vitals?: boolean;
}

const {
  title = `${site.clinicName} — atención y resultados`,
  description = "Diagnóstico y tratamiento personalizado. Escríbenos por WhatsApp y agenda tu valoración.",
  vitals = false,
} = Astro.props;

// Noindex mientras site.ts conserve placeholders (fork plantilla — la
// landing no es una clínica real todavía). Ver landing/public/robots.txt.
const indexable = site.indexable;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    {
      !indexable && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={`${site.baseUrl}${site.landingBase}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.clinicName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.baseUrl}${site.landingBase}/`} />
    <meta name="twitter:card" content="summary" />
    <script is:inline define:vars={{ siteUrl: site.baseUrl }}>
      window.__WACRM_SITE_URL__ = siteUrl;
    </script>
  </head>
  <body class="min-h-screen bg-white text-slate-800">
    <slot />
    <!-- god.js: atribución + beacons (DAD §2.2). Fuera del bundle de Astro: -->
    <script is:inline src="/god.js"></script>
    {vitals && <script src="../scripts/vitals.ts"></script>}
  </body>
</html>
