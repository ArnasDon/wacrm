---
// BaseLayout — shell HTML de la landing (skill §9.1).
//
// Emite las etiquetas de SEO, el grafo JSON-LD (§9.2), las pistas de
// conexión (§8.4) y monta el widget de contacto después de <main> (§7.7).
//
// god.js se conserva tal cual: es el script de atribución (§12.2) y alimenta
// /api/events. Se sirve desde /god.js (raíz de Next, NO desde /landing/).
import "../styles/index.css";
import { site } from "../data/site";
import { buildGraph } from "../lib/schema";
import { resolveSite } from "../lib/site-context";
import type { SiteSettings } from "../lib/site-context";
import ContactLauncher from "../components/ContactLauncher.astro";
import Footer from "../components/sections/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Ruta relativa dentro de landingBase, con barra final. */
  path?: string;
  /**
   * La página se sirve desde la raíz del sitio, no bajo landingBase.
   *
   * Solo afecta al canonical. El HTML se sigue construyendo bajo /landing/
   * (el `base` de Astro resuelve ahí los assets hasheados) y es un rewrite
   * de Next el que lo publica en la raíz; sin esto el canonical apuntaría a
   * una URL que ahora redirige, que es justo lo que un canonical no debe
   * hacer.
   */
  rootPath?: boolean;
  /** Precarga del LCP: la sintaxis debe coincidir con la del elemento (§8.4). */
  preloadHero?: { mobile: string; desktop: string; breakpoint: number };
  /** La página contiene una fachada de video → preconnect condicional. */
  hasVideo?: boolean;
  noindex?: boolean;
  faq?: readonly { q: string; a: string }[];
  steps?: readonly { title: string; text: string }[];
  breadcrumb?: { name: string; item?: string }[];
  /** "Ajustes del sitio" de la landing (opcional). */
  settings?: SiteSettings | null;
}

const {
  title,
  description,
  path = "/",
  rootPath = false,
  preloadHero,
  hasVideo = false,
  noindex = false,
  faq,
  steps,
  breadcrumb,
  settings,
} = Astro.props;

const canonical = `${site.baseUrl}${rootPath ? "" : site.landingBase}${path}`;
// Noindex mientras site.ts conserve placeholders (el fork es una plantilla,
// no una clínica real todavía). Ver landing/public/robots.txt.
const robots = noindex || !site.indexable
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

// Valores efectivos del sitio: default global + overrides de los
// "Ajustes del sitio" editados en el dashboard.
const s = resolveSite(settings);

const graph = buildGraph({
  url: canonical,
  title,
  description,
  faq,
  steps,
  breadcrumb,
});

const brandVars = `:root{--color-primary:${s.theme.primary};--color-primary-dark:${s.theme.primaryDark};--color-accent:${s.theme.accent};}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover es obligatorio: sin él env(safe-area-inset-*)
         devuelve 0px y toda la lógica de área segura queda inerte (§4). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {/* Sin prefijo /landing: los dos archivos viven en el public/ de Next,
        no en el de Astro, porque el mismo icono lo usan la landing y el
        dashboard. Hasta ahora este href apuntaba a un archivo que no
        existía y devolvía 404. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.baseUrl}${site.ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.baseUrl}${site.ogImage}`} />

    {/* Precarga del LCP con dirección de arte: una entrada por variante y el
        mismo `media` que el <picture>, o el navegador descarga dos veces. */}
    {preloadHero && (
      <>
        <link
          rel="preload"
          as="image"
          href={preloadHero.mobile}
          media={`(max-width: ${preloadHero.breakpoint - 1}px)`}
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href={preloadHero.desktop}
          media={`(min-width: ${preloadHero.breakpoint}px)`}
          fetchpriority="high"
        />
      </>
    )}

    {/* Solo los dominios que la página usa de verdad: un preconnect sobrante
        desperdicia una conexión y compite con los recursos reales (§8.4). */}
    {/* Los DOS dominios del vídeo, porque intervienen los dos: el script de la
        API sale de youtube.com y el reproductor se embebe en nocookie (god.ts
        le pasa `host`). Precargar solo uno deja la mitad de la cascada sin
        conexión abierta, y precargar el que no se usa desperdicia una. */}
    {hasVideo && (
      <>
        <link rel="preconnect" href="https://www.youtube.com" />
        <link rel="preconnect" href="https://www.youtube-nocookie.com" />
      </>
    )}

    <style set:html={brandVars}></style>
    <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>

    <script is:inline define:vars={{ siteUrl: site.baseUrl }}>
      window.__WACRM_SITE_URL__ = siteUrl;
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>

    {/* Fuera de <main>: el pie es cromo del sitio, no contenido de la página. */}
    <Footer settings={settings} />

    <ContactLauncher />

    <!-- god.js: atribución + beacons. Fuera del bundle de Astro. -->
    <script is:inline src="/god.js"></script>
    <script>
      // Inyecta el ref_code persistido en los CTA de WhatsApp. Antes se
      // importaba desde el frontmatter de index.astro, así que se ejecutaba
      // en build y nunca llegaba al navegador: el código no viajaba.
      import "../scripts/wa-ref";
    </script>
  </body>
</html>
