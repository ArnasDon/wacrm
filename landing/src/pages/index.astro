---
// index.astro — landing principal, alimentada por la Content Collection.
//
// TODO el contenido de la página vive en src/data/landings/home.json:
// textos, imágenes, videos e incluso el SEO title/description. Este archivo
// solo lee la colección y renderiza los bloques en orden.
//
// El grafo JSON-LD no diverge: faq y steps viajan al layout desde la misma
// fuente que las secciones visibles.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';

import { site } from '../data/site';
import { getCollection } from 'astro:content';

const [home] = await getCollection('landing', ({ id }) => id === 'home');

// Si el JSON no existe o está mal formado, el build ya falló en la colección
// (zod valida). Este guard evita un crash confuso si se borra el archivo.
if (!home) {
  throw new Error('landing: falta src/data/landings/home.json — la Content Collection no devolvió la página home.');
}

const { title, description, blocks } = home.data;

// El grafo JSON-LD (FAQPage + HowTo) se alimenta de los MISMOS bloques que
// se ven en pantalla: si el dueño edita el FAQ en el JSON, el grafo y lo
// visible no pueden divergir.
const faqBlock = blocks.find((b) => b.type === 'faq');
const howBlock = blocks.find((b) => b.type === 'how-it-works');
const faq = (faqBlock?.data as { faq?: { q: string; a: string }[] } | undefined)?.faq ?? site.faq;
const steps = (howBlock?.data as { steps?: { title: string; text: string }[] } | undefined)?.steps ?? site.steps;

// El hero con video de fondo: el poster es el LCP. Las miniaturas van en
// preloadHero (BaseLayout las precarga con el MISMO media que el <picture>
// del hero) y se pasan también al componente: una sola fuente de verdad.
const heroVideoBlock = blocks.find((b) => b.type === 'hero-video');
const heroVideoData = heroVideoBlock?.data as
  | { videoId?: string; desktopVideoId?: string; thumbMobile?: string; thumbDesktop?: string }
  | undefined;
const videoId = heroVideoData?.videoId ?? site.videoId;
const heroThumbMobile = heroVideoData?.thumbMobile ?? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
const heroThumbDesktop = heroVideoData?.thumbDesktop ?? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  hasVideo
  preloadHero={{ mobile: heroThumbMobile, desktop: heroThumbDesktop, breakpoint: 900 }}
  faq={faq}
  steps={steps}
  breadcrumb={[{ name: site.name, item: `${site.baseUrl}${site.landingBase}/` }]}
>
  <BlockRenderer blocks={blocks} />
</BaseLayout>