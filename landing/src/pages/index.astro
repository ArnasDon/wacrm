---
// index.astro — arquetipo transaccional (skill §16).
//
// Secuencia: hero → franja de credibilidad → servicios y precio → video →
// captación → proceso → autoridad → preguntas frecuentes → cierre.
//
// Del arquetipo completo se omiten los bloques para los que no hay contenido
// real (reseñas, testimonios en video, galería, comparativa): inventar
// calificaciones o testimonios sería un dato estructurado falso, y el skill
// exige que cada bloque justifique su presencia (§15.2).
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import SocialProof from "../components/sections/SocialProof.astro";
import Specialties from "../components/sections/Specialties.astro";
import YouTubeLite from "../components/YouTubeLite.astro";
import LeadSection from "../components/sections/LeadSection.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import About from "../components/sections/About.astro";
import Reviews from "../components/sections/Reviews.astro";
import LeadMagnet from "../components/sections/LeadMagnet.astro";
import Faq from "../components/sections/Faq.astro";
import { site } from "../data/site";

const title = "Fisioterapia y rehabilitación en CDMX | Tu Clínica";
const description =
  "Valoración con diagnóstico y plan de tratamiento el mismo día. Fisioterapia, rehabilitación y terapia manual en CDMX. Te respondemos en menos de 24 h.";
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  hasVideo
  faq={site.faq}
  steps={site.steps}
  breadcrumb={[{ name: site.name, item: `${site.baseUrl}${site.landingBase}/` }]}
>
  <Hero />
  <SocialProof />
  <Specialties />

  <section id="video" class="section bg-secondary">
    <div class="container">
      <header class="section-header">
        <h2 class="t-3xl">Lo que dicen nuestros pacientes</h2>
      </header>
      <div class="measure-md mx-auto">
        <YouTubeLite />
      </div>
    </div>
  </section>

  <LeadSection
    id="agenda"
    formId="top"
    heading="Agenda tu valoración"
    sub="Déjanos tus datos y te contactamos por WhatsApp en menos de 24 h. Sin compromiso."
  />

  <HowItWorks />
  <Reviews />
  <LeadMagnet />
  <About />
  <Faq />

  <LeadSection
    id="cierre"
    formId="bottom"
    heading="Empieza hoy"
    sub="Cuanto antes empiece el tratamiento, menos sesiones hacen falta. Te respondemos el mismo día."
  />
</BaseLayout>
