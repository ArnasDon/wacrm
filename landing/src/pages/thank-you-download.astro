---
// thank-you-download.astro — confirmación del imán de leads (skill §14.4).
//
// Textos y bloque editables desde src/data/landings/thank-you-download.json.
// La descarga automática y el script de re-emisión son lógica de atribución
// y viven aquí, no en el bloque.
//
// Lleva noindex siempre, igual que su hermana: una página de agradecimiento
// indexada genera conversiones falsas desde búsqueda orgánica.
import BaseLayout from "../layouts/BaseLayout.astro";
import BlockRenderer from "../components/BlockRenderer.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const [page] = await getCollection("landing", ({ id }) => id === "thank-you-download");

if (!page) {
  throw new Error('landing: falta src/data/landings/thank-you-download.json');
}

const { title, description, blocks, settings } = page.data;

// El PDF vive en landing/public/, que Astro emite bajo `base` — de ahí que
// la URL lleve el prefijo aunque la página se sirva desde la raíz.
//
// La URL es genérica y SIN fecha a propósito: aparece en el historial de
// descargas y en las estadísticas, y renombrarla cada vez que se reescriba la
// guía rompería los enlaces que ya haya por ahí. Un `guia-2026.pdf` caduca en
// enero y obliga justo a ese renombrado. El título real vive dentro del PDF y
// en el texto de la página, no en el nombre del archivo.
//
// Renombrar esto exige añadir el redirect de la ruta vieja en next.config.ts,
// o las descargas ya compartidas pasan a 404.
const pdfHref = `${site.landingBase}/guia.pdf`;
---

<BaseLayout
  title={title}
  description={description}
  path="/thank-you-download/"
  rootPath
  noindex
  settings={settings}
>
  <BlockRenderer blocks={blocks} showChrome={false} settings={settings} />
</BaseLayout>

<script>
  // ── Re-emisión idempotente del form_submit ──
  //
  // Mismo event_id → UNIQUE en tracking_events → no duplica. Recargar esta
  // página no genera una segunda conversión. Idéntico a thank-you.astro
  // salvo el landing_slug, que es lo que separa este lead del comercial.
  const params = new URLSearchParams(location.search);
  if (params.get("lead") === "1") {
    const eventId = params.get("event_id") ?? "";
    fetch(`${location.origin}/api/events`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        event_id: eventId || `magnet_${Date.now().toString(36)}`,
        event_type: "form_submit",
        attribution: { landing_slug: "thank-you-download" },
        landing_slug: "thank-you-download",
        payload: {},
      }),
      keepalive: true,
    }).catch(() => {});
    // Retira el identificador de la URL tras registrarlo (skill §20), para
    // que un refresco o un enlace compartido no lo reenvíe.
    history.replaceState(null, "", location.pathname);
  }
</script>