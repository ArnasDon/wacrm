---
// thank-you.astro — confirmación del lead (skill §14.4).
//
// Detecta ?lead=1 y re-emite form_submit con el MISMO event_id (idempotente
// por UNIQUE en la tabla): cubre el caso de una navegación que pierde la
// primera emisión sin generar una segunda conversión. La PII solo viaja en
// el POST original, nunca en la URL.
//
// Lleva noindex siempre: una página de agradecimiento indexada genera
// conversiones falsas desde búsqueda orgánica.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappHref } from "../data/site";
---

<BaseLayout
  title="Gracias — te contactamos pronto"
  description="Recibimos tu solicitud. Te contactamos por WhatsApp en menos de 24 horas."
  path="/thank-you/"
  noindex
>
  <section class="section text-center">
    <div class="container measure-sm mx-auto">
      <p class="icon-circle t-2xl" aria-hidden="true">✓</p>
      <h1 class="t-3xl">¡Gracias!</h1>
      <p class="lead">
        Recibimos tu solicitud. Te contactaremos por WhatsApp en menos de 24 h.
      </p>
      <div class="btn-row mt-2">
        <a
          href={whatsappHref}
          class="button primary pill"
          target="_blank"
          rel="noopener"
          data-wa-cta
          data-track="whatsapp_click"
          data-track-label="thank_you"
        >
          ¿Prefieres hablar ahora?
        </a>
      </div>
      <p class="mt-2">
        <a href={`${site.landingBase}/`} class="t-sm text-grey">Volver al inicio</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Re-emisión idempotente del form_submit: mismo event_id → UNIQUE → no
  // duplica. Recargar esta página no genera una segunda conversión.
  const params = new URLSearchParams(location.search);
  if (params.get("lead") === "1") {
    const eventId = params.get("event_id") ?? "";
    fetch(`${location.origin}/api/events`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        event_id: eventId || `thank_${Date.now().toString(36)}`,
        event_type: "form_submit",
        attribution: { landing_slug: "thank-you" },
        landing_slug: "thank-you",
        payload: {},
      }),
      keepalive: true,
    }).catch(() => {});
    // Retira el identificador de la URL tras registrarlo (skill §20), para
    // que un refresco o un enlace compartido no lo reenvíe.
    history.replaceState(null, "", location.pathname);
  }
</script>
