---
// thank-you.astro — confirmación del lead (skill §14.4).
//
// Textos y bloque de confirmación editables desde la Content Collection
// (src/data/landings/thank-you.json). La PII solo viaja en el POST original,
// nunca en la URL.
//
// Lleva noindex siempre: una página de agradecimiento indexada genera
// conversiones falsas desde búsqueda orgánica.
import BaseLayout from "../layouts/BaseLayout.astro";
import BlockRenderer from "../components/BlockRenderer.astro";
import { getCollection } from "astro:content";

const [page] = await getCollection("landing", ({ id }) => id === "thank-you");

if (!page) {
  throw new Error('landing: falta src/data/landings/thank-you.json');
}

const { title, description, blocks, settings } = page.data;
---

<BaseLayout
  title={title}
  description={description}
  path="/thank-you/"
  rootPath
  noindex
  settings={settings}
>
  <BlockRenderer blocks={blocks} showChrome={false} settings={settings} />
</BaseLayout>

<script>
  // Re-emisión idempotente del form_submit: mismo event_id → UNIQUE → no
  // duplica. Recargar esta página no genera una segunda conversión.
  const params = new URLSearchParams(location.search);
  if (params.get("lead") === "1") {
    const eventId = params.get("event_id") ?? "";
    fetch(`${location.origin}/api/events`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        event_id: eventId || `thank_${Date.now().toString(36)}`,
        event_type: "form_submit",
        attribution: { landing_slug: "thank-you" },
        landing_slug: "thank-you",
        payload: {},
      }),
      keepalive: true,
    }).catch(() => {});
    // Retira el identificador de la URL tras registrarlo (skill §20), para
    // que un refresco o un enlace compartido no lo reenvíe.
    history.replaceState(null, "", location.pathname);
  }
</script>