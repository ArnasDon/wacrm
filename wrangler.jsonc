{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "whatsapp-crm",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"routes": [
		{
			"pattern": "support.marriagebiodata.site",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "ORDERS_HYPERDRIVE",
			"id": "ef5ded6798064da9bd88c866680fb83e"
		}
	]
}